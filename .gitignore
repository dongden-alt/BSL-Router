.brain/logs/*.jsonl
# Error reports written by observability.py. These capture request context and
# stack traces, which can embed prompts, headers, and provider responses.
artifacts/error_reports/

# ?????? Secrets / local state ??????
# config.yaml holds live API keys ??? NEVER track in a public repo.
config.yaml
# Catch-all for every backup variant. Specific patterns were missed as new
# backup names appeared (e.g. config.yaml.pre-consult-cleanup.*.bak).
config.yaml.*
config.*.yaml
# ...but the shipped template MUST stay tracked. Without this negation,
# config.*.yaml above silently swallows it and new clones lose their starting
# point. Negation must come after the pattern it overrides.
!config.example.yaml
# Encryption key files ??? machine-bound, must never be committed.
.bsl_key
.bsl_key.dpapi
.brain/session.json
.brain/active-task.json
.brain/.bridge-claims/
.brain/scratch/
.brain/recovered_config.yaml
.brain/stash*_config.yaml
.brain/state/

